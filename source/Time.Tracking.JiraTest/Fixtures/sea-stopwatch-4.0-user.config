<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <userSettings>
        <StopWatch.Properties.Settings>
            <setting name="IssueCount" serializeAs="String">
                <value>8</value>
            </setting>
            <setting name="AlwaysOnTop" serializeAs="String">
                <value>True</value>
            </setting>
            <setting name="Username" serializeAs="String">
                <value>marvin@example.com</value>
            </setting>
            <setting name="Password" serializeAs="String">
                <value></value>
            </setting>
            <setting name="JiraBaseUrl" serializeAs="String">
                <value>https://example.atlassian.net/</value>
            </setting>
            <setting name="FirstRun" serializeAs="String">
                <value>False</value>
            </setting>
            <setting name="SaveTimerState" serializeAs="String">
                <value>1</value>
            </setting>
            <setting name="CurrentFilter" serializeAs="String">
                <value>12479</value>
            </setting>
            <setting name="MinimizeToTray" serializeAs="String">
                <value>True</value>
            </setting>
            <setting name="PauseOnSessionLock" serializeAs="String">
                <value>2</value>
            </setting>
            <setting name="AllowMultipleTimers" serializeAs="String">
                <value>False</value>
            </setting>
            <setting name="PostWorklogComment" serializeAs="String">
                <value>0</value>
            </setting>
            <setting name="UpgradeRequired" serializeAs="String">
                <value>False</value>
            </setting>
            <setting name="StartTransitions" serializeAs="String">
                <value>In Progress</value>
            </setting>
            <setting name="LoggingEnabled" serializeAs="String">
                <value>True</value>
            </setting>
            <setting name="IncludeProjectName" serializeAs="String">
                <value>True</value>
            </setting>
            <setting name="StartupForm" serializeAs="String">
                <value>4</value>
            </setting>
            <setting name="ViewWindowSizes" serializeAs="String">
                <value>Ledger=680x724;Grid=900x640</value>
            </setting>
            <setting name="GridPersistedRows" serializeAs="String">
                <value></value>
            </setting>
        </StopWatch.Properties.Settings>
    </userSettings>
</configuration>
