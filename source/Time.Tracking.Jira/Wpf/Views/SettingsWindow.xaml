<Window x:Class="Time.Tracking.Jira.Wpf.Views.SettingsWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:s="clr-namespace:Time.Tracking.Jira"
        xmlns:inf="clr-namespace:Time.Tracking.Jira.Wpf.Infrastructure"
        Title="Time.Tracking.Jira Settings" Width="660" SizeToContent="Height"
        MinWidth="620" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}" FontFamily="{StaticResource AppFont}"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

  <Window.Resources>
    <inf:BoolToVisibilityConverter x:Key="BoolVis"/>
  </Window.Resources>

  <StackPanel>

    <!-- CONNECTION -->
    <StackPanel Margin="22,18,22,14">
      <TextBlock Text="CONNECTION" Style="{StaticResource SectionKicker}"/>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="150"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/><RowDefinition Height="10"/>
          <RowDefinition Height="Auto"/><RowDefinition Height="10"/>
          <RowDefinition Height="Auto"/><RowDefinition Height="10"/>
          <RowDefinition Height="Auto"/><RowDefinition Height="12"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="JIRA base url" Style="{StaticResource FieldLabel}"/>
        <TextBox   Grid.Row="0" Grid.Column="1" Style="{StaticResource ModernTextBox}"
                   Text="{Binding BaseUrl, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Grid.Row="2" Text="Username" Style="{StaticResource FieldLabel}"/>
        <TextBox   Grid.Row="2" Grid.Column="1" Style="{StaticResource ModernTextBox}"
                   Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Grid.Row="4" Text="API token" Style="{StaticResource FieldLabel}"/>
        <Grid Grid.Row="4" Grid.Column="1">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <PasswordBox x:Name="TokenBox" Style="{StaticResource ModernPasswordBox}"
                       PasswordChanged="TokenBox_PasswordChanged"/>
          <Button Grid.Column="1" Content="Create API Token" Margin="12,0,0,0"
                  Style="{StaticResource LinkButton}" Command="{Binding CreateTokenCommand}"/>
        </Grid>

        <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal">
          <CheckBox Content="Enable debug logging" Style="{StaticResource ModernToggle}"
                    IsChecked="{Binding DebugLogging}"/>
          <Button Content="Open log folder" Margin="14,0,0,0"
                  Style="{StaticResource LinkButton}" Command="{Binding OpenLogFolderCommand}"/>
        </StackPanel>

        <Button Grid.Row="8" Grid.Column="1" Content="Import from Jira StopWatch (legacy)…"
                Style="{StaticResource LinkButton}" HorizontalAlignment="Left"
                Command="{Binding ImportLegacyCommand}"/>
      </Grid>
    </StackPanel>

    <Border Style="{StaticResource SectionRule}"/>

    <!-- GENERAL OPTIONS -->
    <StackPanel Margin="22,16,22,16">
      <TextBlock Text="GENERAL OPTIONS" Style="{StaticResource SectionKicker}"/>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/><RowDefinition Height="9"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <CheckBox Grid.Row="0" Grid.Column="0" Content="Always keep window on top"
                  Style="{StaticResource ModernToggle}" IsChecked="{Binding AlwaysOnTop}"/>
        <CheckBox Grid.Row="0" Grid.Column="2" Content="Minimize to tray"
                  Style="{StaticResource ModernToggle}" IsChecked="{Binding MinimizeToTray}"
                  Visibility="{Binding IsMinimizeToTraySupported, Converter={StaticResource BoolVis}}"/>
        <CheckBox Grid.Row="2" Grid.Column="0" Content="Allow running multiple timers simultaneously"
                  Style="{StaticResource ModernToggle}" IsChecked="{Binding AllowMultipleTimers}"/>
      </Grid>
    </StackPanel>

    <Border Style="{StaticResource SectionRule}"/>

    <!-- BEHAVIOUR -->
    <StackPanel Margin="22,16,22,16">
      <TextBlock Text="BEHAVIOUR" Style="{StaticResource SectionKicker}"/>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="150"/><ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/><RowDefinition Height="10"/>
          <RowDefinition Height="Auto"/><RowDefinition Height="10"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Startup form" Style="{StaticResource FieldLabel}"/>
        <ComboBox Grid.Row="0" Grid.Column="1" Style="{StaticResource ModernComboBox}"
                  SelectedValue="{Binding StartupForm}" SelectedValuePath="Tag">
          <ComboBoxItem Content="Ledger — table, one row per subtask" Tag="{x:Static s:StartupFormSetting.Ledger}"/>
          <ComboBoxItem Content="Cards — roomy, every action named" Tag="{x:Static s:StartupFormSetting.Cards}"/>
          <ComboBoxItem Content="Focus — running timer on stage" Tag="{x:Static s:StartupFormSetting.Focus}"/>
          <ComboBoxItem Content="Grid — two columns, keyboard first" Tag="{x:Static s:StartupFormSetting.Grid}"/>
        </ComboBox>

        <TextBlock Grid.Row="2" Text="Save timer states on program exit" Style="{StaticResource FieldLabel}"/>
        <ComboBox Grid.Row="2" Grid.Column="1" Style="{StaticResource ModernComboBox}"
                  SelectedValue="{Binding OnExit}" SelectedValuePath="Tag">
          <ComboBoxItem Content="Reset all timers on exit" Tag="{x:Static s:SaveTimerSetting.NoSave}"/>
          <ComboBoxItem Content="Save current timetracking, pause active timer" Tag="{x:Static s:SaveTimerSetting.SavePause}"/>
          <ComboBoxItem Content="Save current timetracking, active timer continues" Tag="{x:Static s:SaveTimerSetting.SaveRunActive}"/>
        </ComboBox>

        <TextBlock Grid.Row="4" Text="Pause timer on session lock" Style="{StaticResource FieldLabel}"/>
        <ComboBox Grid.Row="4" Grid.Column="1" Style="{StaticResource ModernComboBox}"
                  SelectedValue="{Binding OnSessionLock}" SelectedValuePath="Tag">
          <ComboBoxItem Content="No pause" Tag="{x:Static s:PauseAndResumeSetting.NoPause}"/>
          <ComboBoxItem Content="Pause active timer" Tag="{x:Static s:PauseAndResumeSetting.Pause}"/>
          <ComboBoxItem Content="Pause and resume on unlock" Tag="{x:Static s:PauseAndResumeSetting.PauseAndResume}"/>
        </ComboBox>
      </Grid>
    </StackPanel>

    <Border Style="{StaticResource SectionRule}"/>

    <!-- FOOTER -->
    <Border Background="{StaticResource SurfaceBrush}" Padding="22,14">
      <Grid>
        <Button Content="About…" HorizontalAlignment="Left" Height="34"
                Style="{StaticResource GhostButton}" Click="About_Click"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="Cancel" MinWidth="88" Height="34" IsCancel="True"
                  Style="{StaticResource SecondaryButton}"
                  HorizontalContentAlignment="Center" Click="Cancel_Click"/>
          <Button Content="OK" MinWidth="88" Height="34" IsDefault="True" Margin="8,0,0,0"
                  Style="{StaticResource PrimaryButton}"
                  HorizontalContentAlignment="Center" Click="Ok_Click"/>
        </StackPanel>
      </Grid>
    </Border>
  </StackPanel>
</Window>
