<UserControl x:Class="Time.Tracking.Jira.Wpf.Views.GridView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Time.Tracking.Jira.Wpf.Views"
             xmlns:inf="clr-namespace:Time.Tracking.Jira.Wpf.Infrastructure"
             Background="{StaticResource BgBrush}">
  <!-- Option 1d. Modular 2-column cells, keyboard-first. The number chip is the
       shortcut that starts that cell's timer. -->
  <UserControl.Resources>
    <!-- The chip is also the only way to start a cell with the mouse: an idle cell shows
         no Start button by design, so the chip has to be the button. -->
    <Style x:Key="ChipButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
      <Setter Property="Background" Value="{StaticResource ChipBrush}"/>
      <Setter Property="Width" Value="18"/>
      <Setter Property="Height" Value="18"/>
      <Setter Property="MinHeight" Value="18"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="FontSize" Value="10.5"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{StaticResource PressTintBrush}"/>
        </Trigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>

  <DockPanel>
    <Border DockPanel.Dock="Top" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,2" Padding="24,20,24,16">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
          <TextBlock Style="{StaticResource TimeText}" FontSize="52" Text="{Binding TotalToday}"/>
          <TextBlock Style="{StaticResource KickerText}" FontSize="14" Text="TODAY · UNLOGGED"
                     Margin="12,0,0,8" VerticalAlignment="Bottom"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
          <views:ActionsBar/>
          <Button Style="{StaticResource SecondaryButton}" Height="34" Command="{Binding LogAllCommand}" Margin="0,0,8,0">
            <StackPanel Orientation="Horizontal">
              <Path Style="{StaticResource IconStroke}" Data="{StaticResource IcoUpload}"/>
              <TextBlock Text="Log all" Margin="7,0,0,0"/>
            </StackPanel>
          </Button>
          <Button Style="{StaticResource PrimaryButton}" Height="34" Command="{Binding AddIssueCommand}">
            <StackPanel Orientation="Horizontal">
              <Path Style="{StaticResource IconStroke}" Data="{StaticResource IcoPlus}"/>
              <TextBlock Text="Add issue" Margin="7,0,0,0"/>
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- keyboard legend -->
    <Border DockPanel.Dock="Bottom" Background="{StaticResource SurfaceBrush}" Padding="24,10">
      <Grid>
        <TextBlock FontSize="11" Foreground="{StaticResource MutedTextBrush}" FontFamily="{StaticResource AppFont}"
                   VerticalAlignment="Center">
          <Run Text="1–9" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/><Run Text=" start    "/>
          <Run Text="Space" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/><Run Text=" pause    "/>
          <Run Text="R" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/><Run Text=" reset    "/>
          <Run Text="Ctrl↑" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/><Run Text=" log to Jira    "/>
          <Run Text="Ctrl+N" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/><Run Text=" add issue"/>
        </TextBlock>
        <views:ViewSwitcher HorizontalAlignment="Right"/>
      </Grid>
    </Border>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <ItemsControl ItemsSource="{Binding Entries}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border x:Name="Cell" BorderBrush="{StaticResource RowLineBrush}" BorderThickness="0,0,1,1" Padding="20,16">
              <StackPanel>
                <Grid>
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button x:Name="Chip" Style="{StaticResource ChipButton}"
                            Command="{Binding ToggleCommand}"
                            ToolTip="Start or pause this timer — or press its number key"
                            Content="{Binding Index}"/>
                    <!-- The action strip disappears while the cell runs, so the pinned state
                         gets its own mark next to the chip, which never does. -->
                    <Path x:Name="PinMark" Style="{StaticResource IconStroke}" Data="{StaticResource IcoPin}"
                          Width="12" Height="12" Margin="7,0,0,0" VerticalAlignment="Center"
                          Stroke="{StaticResource MutedTextBrush}" Visibility="Collapsed"
                          ToolTip="Pinned to the top of the list"/>
                  </StackPanel>
                  <StackPanel x:Name="Actions" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource GhostButton}" Width="28" Height="28" Padding="0"
                            HorizontalContentAlignment="Center" ToolTip="Log to Jira" Command="{Binding LogCommand}">
                      <Path Style="{StaticResource IconStroke}" Data="{StaticResource IcoUpload}"/>
                    </Button>
                    <!-- Same quiet cluster the ledger rows use -->
                    <Border Width="1" Height="18" Background="{StaticResource RowLineBrush}" Margin="8,0,8,0"
                            VerticalAlignment="Center"/>
                    <Button x:Name="PinBtn" Style="{StaticResource MinorIconButton}" Margin="0,0,2,0"
                            ToolTip="Pin to the top of the list" Command="{Binding PinCommand}">
                      <Path Style="{StaticResource IconStrokeSmall}" Data="{StaticResource IcoPin}"/>
                    </Button>
                    <inf:MenuButton Style="{StaticResource MinorIconButton}" Margin="0,0,2,0" ToolTip="More actions">
                      <Path Style="{StaticResource IconFill}" Data="{StaticResource IcoMore}" Width="13" Height="13"/>
                      <inf:MenuButton.ContextMenu>
                        <ContextMenu>
                          <MenuItem Header="Open in Jira" Command="{Binding OpenInJiraCommand}"/>
                          <MenuItem Header="Edit issue or subtask" Command="{Binding EditCommand}"/>
                          <MenuItem Header="Reset timer to zero" Command="{Binding ResetCommand}"/>
                        </ContextMenu>
                      </inf:MenuButton.ContextMenu>
                    </inf:MenuButton>
                    <Button Style="{StaticResource MinorIconButton}" ToolTip="Remove" Command="{Binding RemoveCommand}">
                      <Path Style="{StaticResource IconStrokeSmall}" Data="{StaticResource IcoClose}"/>
                    </Button>
                  </StackPanel>
                  <Button x:Name="PauseBtn" Style="{StaticResource OnDarkButton}" MinHeight="28" FontSize="11.5"
                          HorizontalAlignment="Right" Visibility="Collapsed" Command="{Binding ToggleCommand}">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="Pause" VerticalAlignment="Center"/>
                      <Border BorderBrush="{StaticResource OnDarkLineBrush}" BorderThickness="1" Margin="6,0,0,0" Padding="5,1">
                        <TextBlock Text="Space" FontSize="10" FontWeight="Bold"/>
                      </Border>
                    </StackPanel>
                  </Button>
                </Grid>
                <!-- The whole cell starts on double-click; the chip says which key does it too. -->
                <TextBlock x:Name="Time" Style="{StaticResource TimeText}" FontSize="40" Margin="0,10,0,0"
                           Background="Transparent" Cursor="Hand" ToolTip="Double-click to edit the time"
                           Text="{Binding Elapsed}">
                  <TextBlock.InputBindings>
                    <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding EditTimeCommand}"/>
                  </TextBlock.InputBindings>
                </TextBlock>
                <TextBlock x:Name="Key" Style="{StaticResource KeyText}" Margin="0,8,0,0" TextTrimming="CharacterEllipsis">
                  <Run Text="{Binding SubtaskKey, Mode=OneWay}"/>
                  <Run x:Name="Sub" Text="{Binding SubtaskSummary, Mode=OneWay}" FontWeight="Normal" Foreground="{StaticResource MutedTextBrush}"/>
                </TextBlock>
                <TextBlock x:Name="Parent" Style="{StaticResource SummaryText}" FontSize="11">
                  <Run Text="{Binding ParentKey, Mode=OneWay}"/><Run Text=" — "/><Run Text="{Binding ParentSummary, Mode=OneWay}"/>
                </TextBlock>
              </StackPanel>
            </Border>
            <DataTemplate.Triggers>
              <DataTrigger Binding="{Binding IsRunning}" Value="True">
                <Setter TargetName="Cell" Property="Background" Value="{StaticResource TextBrush}"/>
                <Setter TargetName="Chip" Property="Background" Value="{StaticResource AccentBrush}"/>
                <Setter TargetName="Chip" Property="Foreground" Value="{StaticResource InkOnDarkBrush}"/>
                <Setter TargetName="Time" Property="Foreground" Value="{StaticResource InkOnDarkBrush}"/>
                <Setter TargetName="Key" Property="Foreground" Value="{StaticResource InkOnDarkBrush}"/>
                <Setter TargetName="Sub" Property="Foreground" Value="{StaticResource OnDarkMutedBrush}"/>
                <Setter TargetName="Parent" Property="Foreground" Value="{StaticResource OnDarkMutedBrush}"/>
                <Setter TargetName="Actions" Property="Visibility" Value="Collapsed"/>
                <Setter TargetName="PauseBtn" Property="Visibility" Value="Visible"/>
                <Setter TargetName="PinMark" Property="Stroke" Value="{StaticResource OnDarkMutedBrush}"/>
              </DataTrigger>
              <DataTrigger Binding="{Binding HasTime}" Value="False">
                <Setter TargetName="Time" Property="Foreground" Value="{StaticResource FaintTextBrush}"/>
              </DataTrigger>
              <DataTrigger Binding="{Binding IsPinned}" Value="True">
                <Setter TargetName="PinMark" Property="Visibility" Value="Visible"/>
                <Setter TargetName="PinBtn" Property="Background" Value="{StaticResource ToggleOnBrush}"/>
                <Setter TargetName="PinBtn" Property="Foreground" Value="{StaticResource InkOnDarkBrush}"/>
                <Setter TargetName="PinBtn" Property="ToolTip" Value="Unpin — let the cell back down the list"/>
              </DataTrigger>
            </DataTemplate.Triggers>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</UserControl>
