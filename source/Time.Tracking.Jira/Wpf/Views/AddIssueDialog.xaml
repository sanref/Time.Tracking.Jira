<Window x:Class="Time.Tracking.Jira.Wpf.Views.AddIssueDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:inf="clr-namespace:Time.Tracking.Jira.Wpf.Infrastructure"
        Title="Add issue" Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource BgBrush}" FontFamily="{StaticResource AppFont}">

  <Window.Resources>
    <!-- Key over title, the same two-line shape the ledger rows use. -->
    <DataTemplate x:Key="IssueItemTemplate">
      <StackPanel Margin="0,3">
        <TextBlock Style="{StaticResource KeyText}" Text="{Binding Key}"/>
        <TextBlock Style="{StaticResource SummaryText}" Text="{Binding Summary}" MaxWidth="340"/>
      </StackPanel>
    </DataTemplate>
  </Window.Resources>

  <DockPanel>
    <Border DockPanel.Dock="Top" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,2"
            Padding="{StaticResource SectionPadding}">
      <StackPanel>
        <TextBlock x:Name="Kicker" Style="{StaticResource KickerText}" Text="NEW ROW"/>
        <TextBlock Style="{StaticResource KeyText}" FontSize="17" Text="Pick the issue to track" Margin="0,3,0,0"/>
      </StackPanel>
    </Border>

    <Border DockPanel.Dock="Bottom" Background="{StaticResource SurfaceBrush}" Padding="20,12">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="BtnCancel" Style="{StaticResource GhostButton}" Content="Cancel" Margin="0,0,8,0"
                IsCancel="True" Click="Cancel_Click"/>
        <Button x:Name="BtnAccept" Style="{StaticResource PrimaryButton}" Content="Add issue"
                IsDefault="True" Click="Accept_Click"/>
      </StackPanel>
    </Border>

    <StackPanel Margin="20,16,20,16">
      <TextBlock Style="{StaticResource KickerText}" Text="PARENT ISSUE"/>
      <ComboBox x:Name="CboParent" Style="{StaticResource FieldComboBox}" Margin="0,6,0,0"
                IsEditable="True" TextSearch.TextPath="Key"
                inf:IssueSearch.Enabled="True"
                ItemTemplate="{StaticResource IssueItemTemplate}"
                SelectionChanged="Parent_SelectionChanged" LostFocus="Parent_LostFocus"/>
      <TextBlock Style="{StaticResource SummaryText}" Margin="0,5,0,0"
                 Text="Type any part of an issue key: your assigned issues first, then Jira itself — closed issues and other people's included."
                 TextWrapping="Wrap"/>

      <TextBlock Style="{StaticResource KickerText}" Text="SUBTASK" Margin="0,18,0,0"/>
      <ComboBox x:Name="CboSubtask" Style="{StaticResource FieldComboBox}" Margin="0,6,0,0"
                IsEditable="True" TextSearch.TextPath="Key"
                inf:IssueSearch.Enabled="True"
                ItemTemplate="{StaticResource IssueItemTemplate}"/>
      <TextBlock x:Name="SubtaskStatus" Style="{StaticResource SummaryText}" Margin="0,5,0,0"
                 Text="Leave empty to log the time against the parent issue."/>
    </StackPanel>
  </DockPanel>
</Window>
