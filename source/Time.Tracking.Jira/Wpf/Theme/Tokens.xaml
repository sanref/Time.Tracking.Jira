<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

  <!-- Modernist tokens. Every color in the app comes from here. -->
  <Color x:Key="Bg">#FFF3F2F2</Color>
  <Color x:Key="Surface">#FFEAE9E9</Color>
  <Color x:Key="Ink">#FF201E1D</Color>
  <Color x:Key="Accent">#FFEC3013</Color>

  <SolidColorBrush x:Key="BgBrush"        Color="{StaticResource Bg}"/>
  <SolidColorBrush x:Key="SurfaceBrush"   Color="{StaticResource Surface}"/>
  <SolidColorBrush x:Key="TextBrush"      Color="{StaticResource Ink}"/>
  <SolidColorBrush x:Key="AccentBrush"    Color="{StaticResource Accent}"/>
  <SolidColorBrush x:Key="Accent100Brush" Color="#FFFFF2EF"/>
  <SolidColorBrush x:Key="Accent400Brush" Color="#FFFF9783"/>
  <SolidColorBrush x:Key="Accent600Brush" Color="#FFDD2B0F"/>
  <SolidColorBrush x:Key="Accent700Brush" Color="#FFAE1800"/>
  <SolidColorBrush x:Key="Neutral600Brush" Color="#FF7D7979"/>
  <SolidColorBrush x:Key="Neutral700Brush" Color="#FF605D5D"/>
  <SolidColorBrush x:Key="InkOnDarkBrush" Color="{StaticResource Bg}"/>

  <!-- The one green in the app: "the Jira session is live". Accent stays reserved for the
       primary action and the running timer, so a healthy connection must not share it. -->
  <SolidColorBrush x:Key="PositiveBrush" Color="#FF1E8E3E"/>

  <!-- 40% ink: the strong 2px section divider -->
  <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource Ink}" Opacity="0.4"/>
  <!-- 15% ink: the light row separator inside a list -->
  <SolidColorBrush x:Key="RowLineBrush" Color="{StaticResource Ink}" Opacity="0.15"/>
  <SolidColorBrush x:Key="MutedTextBrush" Color="{StaticResource Ink}" Opacity="0.6"/>
  <SolidColorBrush x:Key="FaintTextBrush" Color="{StaticResource Ink}" Opacity="0.35"/>
  <SolidColorBrush x:Key="HoverTintBrush" Color="{StaticResource Ink}" Opacity="0.07"/>
  <SolidColorBrush x:Key="PressTintBrush" Color="{StaticResource Ink}" Opacity="0.14"/>
  <SolidColorBrush x:Key="ChipBrush" Color="{StaticResource Ink}" Opacity="0.12"/>
  <!-- A small toggle button switched on (a pinned row): solid ink, light glyph. Reads as
       "active" at a glance without borrowing the accent, which stays with the primary
       action and the running timer. -->
  <SolidColorBrush x:Key="ToggleOnBrush" Color="{StaticResource Ink}"/>
  <SolidColorBrush x:Key="OnDarkMutedBrush" Color="{StaticResource Bg}" Opacity="0.6"/>
  <SolidColorBrush x:Key="OnDarkLineBrush" Color="{StaticResource Bg}" Opacity="0.45"/>

  <!-- Archivo is not on Windows by default. Drop the .ttf files in Wpf\Fonts with
       Build Action = Resource to get the real thing; until then this falls back to
       Segoe UI, which also has tabular figures. -->
  <FontFamily x:Key="AppFont">pack://application:,,,/Wpf/Fonts/#Archivo, Segoe UI</FontFamily>

  <!-- space scale: 4 / 8 / 12 / 16 / 24 / 32 -->
  <Thickness x:Key="RowPadding">20,12,20,12</Thickness>
  <Thickness x:Key="CardPadding">16,14,16,14</Thickness>
  <Thickness x:Key="SectionPadding">20,18,20,14</Thickness>
  <sys:Double x:Key="RowMinHeight">56</sys:Double>
</ResourceDictionary>
